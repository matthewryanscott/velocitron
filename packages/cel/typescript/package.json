{
  "author": "Matthew R. Scott",
  "bugs": {
    "url": "https://github.com/matthewryanscott/velocitron/issues"
  },
  "dependencies": {
    "@marcbachmann/cel-js": "8.0.0"
  },
  "description": "CEL compile and eval adapter for Velocitron. Does not fire nets or lower .petrinet.",
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://github.com/matthewryanscott/velocitron",
  "license": "MIT",
  "name": "@velocitron/cel",
  "private": true,
  "repository": {
    "directory": "packages/cel/typescript",
    "type": "git",
    "url": "git+https://github.com/matthewryanscott/velocitron.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.build.json && node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.build.json && tsc -p tsconfig.json --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.1.0"
}
