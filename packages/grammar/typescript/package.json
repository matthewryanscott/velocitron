{
  "author": "Matthew R. Scott",
  "bugs": {
    "url": "https://github.com/circuitmeridian/velocitron/issues"
  },
  "dependencies": {
    "antlr4": "4.13.2"
  },
  "description": "Syntax parser for Velocitron .petrinet net and composition documents. Does not lower IR or compile CEL.",
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./package.json": "./package.json",
    "./VelocitronPetriNet.g4": "./VelocitronPetriNet.g4"
  },
  "files": [
    "dist",
    "index.d.ts",
    "index.js",
    "LICENSE",
    "README.md",
    "VelocitronPetriNet.g4"
  ],
  "homepage": "https://github.com/circuitmeridian/velocitron",
  "license": "MIT",
  "name": "@velocitron/grammar",
  "private": true,
  "repository": {
    "directory": "packages/grammar/typescript",
    "type": "git",
    "url": "git+https://github.com/circuitmeridian/velocitron.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.build.json && node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.1.0"
}
