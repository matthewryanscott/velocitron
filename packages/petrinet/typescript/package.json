{
  "author": "Matthew R. Scott",
  "bugs": {
    "url": "https://github.com/circuitmeridian/velocitron/issues"
  },
  "dependencies": {
    "@velocitron/cel": "workspace:*",
    "@velocitron/dsl": "workspace:*",
    "@velocitron/engine": "workspace:*",
    "@velocitron/merge": "workspace:*"
  },
  "description": "Compiles .petrinet text and contribution IR to canonical JSON. Does not fire nets, check plays, or own the CLI.",
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://github.com/circuitmeridian/velocitron",
  "license": "MIT",
  "name": "@velocitron/petrinet",
  "private": true,
  "repository": {
    "directory": "packages/petrinet/typescript",
    "type": "git",
    "url": "git+https://github.com/circuitmeridian/velocitron.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.build.json && node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.build.json && tsc -p tsconfig.json --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.1.0"
}
