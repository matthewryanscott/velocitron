{
  "author": "Matthew R. Scott",
  "bugs": {
    "url": "https://github.com/circuitmeridian/velocitron/issues"
  },
  "dependencies": {
    "@velocitron/cel": "workspace:*",
    "@velocitron/engine": "workspace:*"
  },
  "description": "Runs a Velocitron net asynchronously and evaluates intended waits. Does not store a journal or fire through Engine.fire.",
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://github.com/circuitmeridian/velocitron",
  "license": "MIT",
  "name": "@velocitron/runtime",
  "private": true,
  "repository": {
    "directory": "packages/runtime/typescript",
    "type": "git",
    "url": "git+https://github.com/circuitmeridian/velocitron.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.build.json && node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.build.json && tsc -p tsconfig.json --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.1.0"
}
